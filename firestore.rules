rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: checks if user is logged in via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // 1. Site Settings (Business info, phones, WhatsApp, SEO): Public view, Admin edit
    match /siteSettings/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // 2. Destinations (Assam, Meghalaya, etc.): Public view, Admin manage
    match /destinations/{destId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // 3. Tourist Places (58 sightseeing places): Public view, Admin manage
    match /touristPlaces/{placeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // 4. Tour Packages: Public view, Admin manage
    match /tourPackages/{packageId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // 5. Vehicles & Car Rental Fleet: Public view rates, Admin manage
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // 6. Blogs & Categories: Public view, Admin manage
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /blogCategories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // 7. Media & Uploads metadata: Public view, Admin manage
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // 8. Customer Booking & Quotation Enquiries:
    // - Any website visitor can submit an enquiry
    // - ONLY logged-in Admin can view, update status, or delete leads
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
    
    // 9. Guest Reviews & Testimonials:
    // - Any visitor can submit a review (status: 'pending')
    // - Public can read reviews (website filters approved)
    // - ONLY logged-in Admin can approve, reject, or delete reviews
    match /reviews/{reviewId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAuthenticated();
    }
    
    // 10. Admins & Redirects collections
    match /admins/{adminId} {
      allow read, write: if isAuthenticated();
    }
    
    match /redirects/{redirectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
